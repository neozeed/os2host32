env-test-host: cmdos2_env.c cmdos2_env.h cmdos2.h env-test.c
	$(CC) $(CFLAGS) -o $@ cmdos2_env.c env-test.c

env-check: env-test-host
	./env-test-host

# Host-independent syntax gate for the CMD file layer and future LX backend.
boundary-check:
	$(CC) $(CFLAGS) -fsyntax-only cmdfile.c cmdos2_env.c

pipeline-boundary-check:
	! grep -E "CreateProcessA|WaitForSingleObject|GetExitCodeProcess|GetModuleFileNameA|[^A-Za-z0-9_]CreatePipe\(" cmd32os2.c

console-boundary-check:
	! grep -E "GetStdHandle|ReadConsole|WriteConsole|FillConsole|SetConsole|ScrollConsole" cmd32os2.c


