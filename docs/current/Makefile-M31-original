m29p-file-check: m29p-rename-host-test
	./m29p-rename-host-test
	! grep -E "char[[:space:]]+tok\[CF_COPY|char[[:space:]]+srcs\[CF_COPY|unsigned char[[:space:]]+buf\[CF_COPY_BUF" cmdfile.c

cmd32-copy-qol-host-test: cmd32-copy-qol-host-test.c cmdfile.c cmdfile.h cmdos2.h
	$(CC) $(CFLAGS) -ffunction-sections -fdata-sections -Wl,--gc-sections -o $@ cmd32-copy-qol-host-test.c

