parser-check: parse-test-host
	./parse-test-host


batch-test-host: cmdbatch.c cmdbatch.h batch-test.c
	$(CC) $(CFLAGS) -o $@ cmdbatch.c batch-test.c

batch-check: batch-test-host
	./batch-test-host


m29o-batch-host-test: cmdbatch.c cmdbatch.h m29o-batch-host-test.c
