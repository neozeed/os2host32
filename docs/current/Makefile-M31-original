CC ?= cc
CFLAGS ?= -O2 -Wall -Wextra -pedantic -std=c89
MINGW ?= i686-w64-mingw32-gcc

PYTHON ?= python
OS2CMD ?= CMD-OS2.EXE
NTCMD ?= CMD-NT1991.EXE


all: tools compat

tools: le2pe386.exe os2host32.exe cmd32os2.exe m29n2b2-setentry.exe

compat: DOSCALLS.dll KBDCALLS.dll VIOCALLS.dll QUECALLS.dll SESMGR.dll NLS.dll PMWIN.dll PMGPI.dll PMSHAPI.dll PMWP.dll HELPMGR.dll

# Friendly alias for people thinking in terms of the compatibility DLL set.
dlls: compat

crosswalk:
	$(PYTHON) tools/ntcmd_symbols.py "$(NTCMD)" analysis
	$(PYTHON) tools/build_cmd_crosswalk.py analysis/nt_functions.tsv analysis
	$(PYTHON) tools/compare_cmd_strings.py "$(OS2CMD)" "$(NTCMD)" analysis

le2pe386.exe: le2pe386.c
	$(MINGW) -O2 -Wall -o $@ le2pe386.c


m29n2b2-setentry.exe: m29n2b2-setentry.c
	$(MINGW) -std=c89 -O2 -Wall -Wextra -pedantic -o $@ m29n2b2-setentry.c
os2host32.exe: os2host32.c os2host32.def
	$(MINGW) -std=c89 -O2 -Wall -Wextra -pedantic -Wl,--disable-dynamicbase,--image-base,0x400000 -o $@ os2host32.c os2host32.def

cmd32os2.exe: cmd32os2.c cmdparse.c cmdparse.h cmdbatch.c cmdbatch.h cmdfile.c cmdfile.h cmdos2_win32.c cmdos2_session_win32.c cmdos2_env.c cmdos2_env.h cmdos2.h
	$(MINGW) -std=c89 -O2 -Wall -Wextra -pedantic -o $@ cmd32os2.c cmdparse.c cmdbatch.c cmdfile.c cmdos2_win32.c cmdos2_session_win32.c cmdos2_env.c

parse-test-host: cmdparse.c cmdparse.h parse-test.c
