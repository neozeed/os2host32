+        }
+        if (idx == x->import_count)
+            fail("M30 EMX far16 target vanished");
+        host = x->imports[idx].address;
+        stub[p++] = 0xb8; wr32(stub + p, host); p += 4;
+        stub[p++] = 0xff; stub[p++] = 0xd0;
+        if (pushed_bytes != 0) {
