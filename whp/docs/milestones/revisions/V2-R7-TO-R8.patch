+echo Running queue1
+whp_os2_v2_hi.exe queue1.exe 2>queue1-trace.txt
+if errorlevel 1 goto failed
+echo Running recycle1
+whp_os2_v2_hi.exe recycle1.exe 2>recycle1-trace.txt
