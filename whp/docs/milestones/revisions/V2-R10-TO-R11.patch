+>>gpi1.lnk echo gpi1.exe
+>>gpi1.lnk echo gpi1.map
+>>gpi1.lnk echo %C386LIB%\libc.lib %C386LIB%\os2386.lib
+>>gpi1.lnk echo gpi1.def
+link386 @gpi1.lnk
+if errorlevel 1 exit /b %errorlevel%
+exit /b 0
