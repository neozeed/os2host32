+#!/usr/bin/env python3
+"""Build and execute production helpers against native WHP register doubles."""
+import pathlib, subprocess, tempfile
+root = pathlib.Path(__file__).resolve().parents[1]
+s = (root / 'whp_os2_v2_hi.c').read_text()
+def function(name):
+    start = s.index('static ', s.rfind('\nstatic ', 0, s.index(name + '(')))
+    brace = s.index('{', s.index(name + '(', start))
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (s[end] == '{') - (s[end] == '}')
+        end += 1
+    return s[start:end] + '\n'
+with tempfile.TemporaryDirectory() as tmp:
+    p = pathlib.Path(tmp)
+    (p / 'info-production.inc').write_text(
+        (root / 'v2_info.h').read_text() + '\n' +
+        '\n'.join(function(n) for n in ['save_thread_context', 'load_thread_context', 'create_guest_thread']))
+    subprocess.run(['gcc', '-std=c99', '-Wall', '-Wextra', '-Werror',
+                    '-fsanitize=address,undefined', '-g', '-I'+tmp,
+                    str(root / 'tests/info-check.c'), '-o', str(p/'check')], check=True)
+    subprocess.run([str(p/'check')], check=True)
