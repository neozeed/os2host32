+/* Native test double for WHP registers; executes production info helpers,
+ * context save/load and thread creation. Does not emulate x86 or Windows WHP. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <assert.h>
+typedef uint16_t UINT16;
+typedef int HRESULT;
+typedef int WHV_REGISTER_NAME;
+typedef struct { uint64_t Base; uint32_t Limit; uint16_t Selector, Attributes; } WHV_X64_SEGMENT_REGISTER;
+typedef union { uint64_t Reg64; WHV_X64_SEGMENT_REGISTER Segment; } WHV_REGISTER_VALUE;
+#define SUCCEEDED(x) ((x) == 0)
+#define FAILED(x) ((x) != 0)
+#define E_FAIL 1
+#define OS2_NO_ERROR 0u
+#define OS2_ERROR_INVALID_FUNCTION 1u
+#define OS2_ERROR_NOT_ENOUGH_MEMORY 8u
+#define OS2_ERROR_INVALID_PARAMETER 87u
+#define RAM_SIZE 0x04000000u
+#define MAX_THREADS 32u
+#define THREAD_REG_COUNT 16
+#define GUEST_INFO 0x00e20000u
+#define GUEST_INFO_LIMIT 0x00e23000u
+#define GUEST_GDT 0x7000u
+#define GUEST_THREAD_EXIT_STUB 0x000f7ff0u
+static const WHV_REGISTER_NAME thread_reg_names[16] = {0};
+enum GuestThreadState { THREAD_FREE, THREAD_RUNNING, THREAD_RUNNABLE, THREAD_SUSPENDED };
+struct GuestThread {
+ uint32_t tid; enum GuestThreadState state;
+ uint32_t stack_base, stack_size;
+ WHV_REGISTER_VALUE regs[16]; int regs_valid;
+};
+struct GuestAlloc { int used; };
+struct Runtime {
+ void *partition; uint8_t *ram;
+ struct GuestThread threads[MAX_THREADS];
+ int current_thread; uint32_t next_tid, alloc_next;
+};
+static WHV_REGISTER_VALUE cpu[16];
+static int fail_get;
+static HRESULT WHvGetVirtualProcessorRegisters(void *p, int v,
+ const WHV_REGISTER_NAME *n, int count, WHV_REGISTER_VALUE *regs)
+{
+ (void)p; (void)v; (void)n;
+ if(fail_get) return E_FAIL;
+ memcpy(regs, cpu, (size_t)count * sizeof(*regs)); return 0;
+}
+static HRESULT WHvSetVirtualProcessorRegisters(void *p, int v,
+ const WHV_REGISTER_NAME *n, int count, const WHV_REGISTER_VALUE *regs)
+{
+ (void)p; (void)v; (void)n;
+ memcpy(cpu, regs, (size_t)count * sizeof(*regs)); return 0;
+}
+static void wr32(uint8_t *p, uint32_t v)
+{ p[0]=(uint8_t)v; p[1]=(uint8_t)(v>>8); p[2]=(uint8_t)(v>>16); p[3]=(uint8_t)(v>>24); }
+static uint32_t rd32(const uint8_t *p)
+{ return p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24; }
+static int guest_range(uint32_t p, uint32_t n) { return p<RAM_SIZE && n<=RAM_SIZE-p; }
+static void guest_put_u32(struct Runtime *rt,uint32_t p,uint32_t v) { assert(guest_range(p,4)); wr32(rt->ram+p,v); }
+static uint32_t align_up(uint32_t n,uint32_t a) { return (n+a-1)&~(a-1); }
+static uint32_t alloc_guest(struct Runtime *rt,uint32_t n)
+{ uint32_t p=rt->alloc_next; rt->alloc_next+=n; return p; }
+static struct GuestAlloc allocation;
+static struct GuestAlloc *find_alloc(struct Runtime *rt,uint32_t p) { (void)rt;(void)p;return &allocation; }
+static const char *thread_state_name(enum GuestThreadState s) { (void)s;return "test"; }
+#include "info-production.inc"
+int main(void)
+{
+ struct Runtime rt;
+ uint32_t i,r,tib,base,selector;
+ uint8_t *d;
+ memset(&rt,0,sizeof(rt)); rt.ram=calloc(1,RAM_SIZE); assert(rt.ram);
+ rt.current_thread=0; rt.next_tid=2; rt.alloc_next=0x1000000;
+ init_process_info(&rt,0xe00000,0xe00100,0x300);
+ assert(rd32(rt.ram+GUEST_INFO+24)==3);
+ init_process_info(&rt,0xe00000,0xe00100,0x200);
+ assert(rd32(rt.ram+GUEST_INFO+24)==2);
+ assert(rd32(rt.ram+GUEST_INFO)==1);
+ assert(rd32(rt.ram+GUEST_INFO+12)==0xe00100);
+ assert(rd32(rt.ram+GUEST_INFO+16)==0xe00000);
+ rt.threads[0].tid=1; rt.threads[0].state=THREAD_RUNNING;
+ rt.threads[0].stack_base=0x20000; rt.threads[0].stack_size=0x8000;
+ rt.threads[0].regs_valid=1;
+ init_thread_info(&rt,0); assert(load_thread_context(&rt,&rt.threads[0])==0);
+ for(i=1;i<MAX_THREADS;i++) {
+   assert(create_guest_thread(&rt,0x500,0x10000,i,0,16384)==0);
+   assert(rd32(rt.ram+0x500)==i+1);
+   assert(rt.threads[i].regs[1].Reg64==rt.threads[i].stack_base+16384-8);
+ }
