+    transformer = read("transformer/le2pe386.c")
+
+    errors: list[str] = []
+
+    for ordinal, name in SHARED_DOSCALLS.items():
+        catalog_pattern = re.compile(
+            rf'OS2_API\("DOSCALLS",\s*{ordinal}u,\s*"{re.escape(name)}",'
+            rf".*OS2_API_ROUTE_SHARED\)"
+        )
