+int cpui386_set_state(CPUI386 *cpu, const CPUI386_State *state)
+{
+	int segs[] = { SEG_ES, SEG_SS, SEG_DS, SEG_FS, SEG_GS, SEG_CS };
+	if (!cpu || !state)
+		return 0;
+
+	for (int i = 0; i < 8; ++i)
+		REGi(i) = state->gpr[i];
+	cpu->flags = state->flags;
+	cpu->cc.mask = 0;
+	cpu->gdt.base = state->gdt_base;
+	cpu->gdt.limit = state->gdt_limit;
+	cpu->idt.base = state->idt_base;
+	cpu->idt.limit = state->idt_limit;
+	cpu->cr0 = state->cr0;
+	cpu->cr2 = state->cr2;
+	cpu->cr3 = state->cr3;
+#ifdef AMD64_ENABLE_LEG32
+	SET_LM_EFER(cpu, state->efer);
+#else
+	(void)state->efer;
+#endif
+	tlb_clear(cpu);
+
+	for (int i = 0; i < 6; ++i) {
+		int seg = segs[i];
+		if (!set_seg(cpu, seg, (int)state->seg[seg]))
+			return 0;
+	}
+	cpu->seg[SEG_LDT].sel = (u16)state->seg[SEG_LDT];
+	cpu->seg[SEG_TR].sel = (u16)state->seg[SEG_TR];
+	cpu->ip = state->ip;
+	cpu->next_ip = state->next_ip;
+	cpu->ifetch.laddr = -1;
+	cpu->ifetch.paddr = 0;
+	cpu->halt = false;
+	cpu->excno = 0;
+	cpu->excerr = 0;
+	return 1;
+}
