    SENDTO        @14
    SETSOCKOPT    @15
    SOCKET        @16
    SOCLOSE       @17
    SOCK_ERRNO    @20
    SHUTDOWN      @25
    SOCK_INIT     @26
    SET_ERRNO     @35
